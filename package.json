{
  "name": "comunica-paths",
  "version": "0.0.0",
  "description": "Streaming path queries over one or more RDF sources through Comunica",
  "license": "MIT",
  "type": "commonjs",
  "lsd:module": true,
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./config/config-default.json": "./config/config-default.json",
    "./components/*": "./components/*",
    "./package.json": "./package.json"
  },
  "files": [
    "components",
    "config",
    "dist",
    "engine-default.cjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && componentsjs-generator . && comunica-compile-config config/config-default.json urn:comunica:paths:init > engine-default.cjs",
    "clean": "rm -rf components dist engine-default.cjs *.tsbuildinfo",
    "prepack": "npm run build",
    "test": "npm run build && tsc -p tsconfig.types.json && node --test test/*.test.mjs",
    "test:live": "npm run build && node scripts/live-smoke.mjs"
  },
  "dependencies": {
    "@comunica/actor-init-query": "^5.3.0",
    "@comunica/bus-query-process": "^5.3.0",
    "@comunica/bus-rdf-join": "^5.3.0",
    "@comunica/config-query-sparql": "^5.3.0",
    "@comunica/context-entries": "^5.3.0",
    "@comunica/core": "^5.3.0",
    "@comunica/mediator-race": "^5.3.0",
    "@comunica/query-sparql": "^5.3.0",
    "@comunica/runner": "^5.3.0",
    "@comunica/types": "^5.3.0",
    "@comunica/utils-algebra": "^5.3.0",
    "@comunica/utils-metadata": "^5.3.0",
    "@comunica/utils-query-operation": "^5.3.0",
    "@rdfjs/term-map": "^2.0.2",
    "@rdfjs/term-set": "^2.0.3",
    "@rdfjs/types": "^2.0.1",
    "asynciterator": "^3.10.0",
    "sparqljs": "^3.7.4"
  },
  "devDependencies": {
    "@types/rdfjs__term-map": "^2.0.10",
    "@types/rdfjs__term-set": "^2.0.9",
    "@types/node": "^26.0.0",
    "@types/sparqljs": "^3.1.12",
    "componentsjs-generator": "^4.2.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/frink-okn/comunica-paths.git"
  }
}
