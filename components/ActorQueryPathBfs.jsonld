  "@id": "npmd:comunica-paths",
  "components": [
    {
      "@id": "cpaths:components/ActorQueryPathBfs.jsonld#ActorQueryPathBfs",
      "@type": "Class",
      "requireElement": "ActorQueryPathBfs",
      "extends": [
        "cpaths:components/ActorQueryPath.jsonld#ActorQueryPath"
      ],
      "comment": "Executes breadth-first path traversal while delegating every frontier join to Comunica's RDF-join mediator.",
      "parameters": [
        {
          "@id": "cpaths:components/ActorQueryPathBfs.jsonld#ActorQueryPathBfs_args_queryProcessor",
          "range": "cbqp:components/ActorQueryProcess.jsonld#IQueryProcessSequential",
          "comment": "The standard sequential query processor used to parse, optimize, and evaluate graph patterns."
        },
        {
          "@id": "cpaths:components/ActorQueryPathBfs.jsonld#ActorQueryPathBfs_args_mediatorRdfJoin",
          "range": "cc:components/Mediator.jsonld#Mediator",
          "comment": "The configured RDF-join mediator used for frontier/VIA and candidate/END joins."
        },
        {
          "@id": "cpaths:components/ActorQueryPathBfs.jsonld#ActorQueryPathBfs_args_batchSize",
          "range": {
            "@type": "ParameterRangeUnion",
            "parameterRangeElements": [
              "xsd:number",
              {
                "@type": "ParameterRangeUndefined"
              }
            ]
          },
          "comment": "Maximum number of frontier bindings submitted in one mediated join."
        },
        {
          "@id": "cpaths:components/ActorQueryPathBfs.jsonld#ActorQueryPathBfs_args_name",
          "range": "xsd:string",
          "default": {
            "@id": "rdf:subject"
          },
          "comment": "The name for this actor."
        },
        {
          "@id": "cpaths:components/ActorQueryPathBfs.jsonld#ActorQueryPathBfs_args_bus",
