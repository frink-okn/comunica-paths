              },
              {
                "@type": "ParameterRangeGenericTypeReference",
                "parameterRangeGenericType": "cpaths:components/ActorQueryPath.jsonld#ActorQueryPath__generic_TS"
              }
            ]
          },
          "default": {
            "@id": "cpaths:components/ActorQueryPath.jsonld#ActorQueryPath_default_bus",
            "@type": "cc:components/Bus.jsonld#Bus"
          },
          "comment": "The bus this actor subscribes to."
        },
        {
          "@id": "cpaths:components/ActorQueryPathBfs.jsonld#ActorQueryPathBfs_args_busFailMessage",
          "range": {
            "@type": "ParameterRangeUnion",
            "parameterRangeElements": [
              "xsd:string",
              {
                "@type": "ParameterRangeUndefined"
              }
            ]
          },
          "comment": "The message that will be configured in the bus for reporting failures.  This message may be a template string that contains references to the executed `action`. For example, the following templated string is allowed: \"RDF dereferencing failed: no actors could handle ${action.handle.mediaType}\""
        },
        {
          "@id": "cpaths:components/ActorQueryPathBfs.jsonld#ActorQueryPathBfs_args_beforeActors",
          "range": {
            "@type": "ParameterRangeUnion",
            "parameterRangeElements": [
